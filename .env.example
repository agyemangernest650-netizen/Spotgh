CLOUDINARY_CLOUD_NAME=djnmz2ivz
CLOUDINARY_API_KEY=382528532717972
CLOUDINARY_API_SECRET=VjusVJYrLKSpI0c1cV6i-ftqCyM

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=Agyemang
JWT_EXPIRES_IN=7d

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=agyemangernest733@gmail.com
EMAIL_PASS=agyemang123
EMAIL_FROM="SpotGH <agyemangernest733@gmail.com>"

# Paystack (https://paystack.com)
PAYSTACK_PUBLIC_KEY=pk_live_fc038132bb4e798a5b118c99eca7407a1d57e6b8
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# hCaptcha (spam protection on register + forgot-password) — get free keys at
# https://dashboard.hcaptcha.com/signup. Leave both blank to disable captcha
# entirely (register/forgot-password just work without it, no code changes needed).
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=
# Note: Paystack has no separate webhook secret (unlike Stripe) — webhook
# signatures are verified using PAYSTACK_SECRET_KEY above. Just register
# your webhook URL in the Paystack dashboard: Settings > API Keys & Webhooks.

# SMS - Arkesel Ghana (https://arkesel.com)
ARKESEL_API_KEY=VWZXc3VHaGh4aHlrRHhMcEl6Zm4
ARKESEL_SENDER_ID=SpotGH

# AI - Anthropic Claude
ANTHROPIC_API_KEY=curl https://api.anthropic.com/v1/organizations/api_keys/$API_KEY_ID \
    -H 'anthropic-version: 2023-06-01' \
    -H "Authorization: Bearer $ANTHROPIC_OAUTH_TOKEN"

# Google Calendar sync (bookings) — create OAuth credentials at
# https://console.cloud.google.com/apis/credentials, enable the Google
# Calendar API, and add GOOGLE_CALENDAR_REDIRECT_URI as an authorized
# redirect URI on the OAuth client. Leave blank to disable — business
# owners just won't see the "Connect Google Calendar" option.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Google Maps (optional)
GOOGLE_MAPS_API_KEY=AIzaSyBxVDEPMpSOEH4S-hYjx2ROXBlwd06f4O4

# Analytics (optional)
GA_TRACKING_ID=G-LZ9W56NZ24

# Push Notifications (Web Push / VAPID) — generate with:
#   npx web-push generate-vapid-keys
# Push silently no-ops until both of these are set; nothing breaks without them.
VAPID_PUBLIC_KEY=BJeEkTdinK6QY-dmWq2tI0bmx56R5jQKjMzcEz8dGHGTBbxiAwli_IXfLf1uz4kHYXJon5549SC_jZNdLAD_CZ4
VAPID_PRIVATE_KEY=LNzWjv2OkPa2lyoR_C82lbycVYyy7p7iAkKAuWB5CC0
# Shown as the contact address in the push subscription's mailto: (falls back
# to support@spotgh.com if unset)
SUPPORT_EMAIL=agyemangernest733@gmail.com

# Creator email (super admin) — whoever registers or signs in with this
# exact email is automatically granted the 'creator' role (full admin
# access to /pages/creator.html). This is the ONLY way to bootstrap admin
# access — set this BEFORE you register your own account, then sign up
# normally with this email.
CREATOR_EMAIL=agyemangernest733@gmail.com