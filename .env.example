# ============================================================
# SpotGH — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Bare domain for mini-website subdomains, e.g. spotgh.com — requires a
# wildcard DNS record (*.spotgh.com) pointed at this server in production.
ROOT_DOMAIN=localhost
APP_NAME=SpotGH
APP_SECRET=Agyemang

